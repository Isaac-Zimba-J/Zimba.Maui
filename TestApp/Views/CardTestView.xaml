<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TestApp.Views.CardTestView"
             xmlns:zimba="clr-namespace:Zimba.Maui.Controls;assembly=Zimba.Maui"
             BackgroundColor="#F5F5F5"
             Title="UI Cards">
    <ScrollView>
        <VerticalStackLayout Padding="16"
                             Spacing="24">
            <!-- Minimal Card with Shadow -->
            <zimba:Card Title="Simple Card"
                        CardCornerRadius="8"
                        HasShadow="True"
                        Elevation="1"
                        ShowTitleSection="False"
                        BackgroundColor="White">
                <zimba:Card.CardContent>
                    <Label Text="This is a simple card style."
                           FontSize="16"
                           TextColor="#444444" />
                </zimba:Card.CardContent>
            </zimba:Card>
            <!-- Card with Footer Action -->
            <zimba:Card Title="Action Required"
                        CardCornerRadius="12"
                        HasShadow="True"
                        BackgroundColor="White"
                        ShadowRadius="10"
                        ShadowOpacity="0.3"
                        ShadowOffset="0,4"
                        ShowFooterSection="True"
                        StrokeThickness="0">
                <zimba:Card.CardContent>
                    <Label Text="Please confirm your action below."
                           FontSize="16"
                           Padding="0"
                           TextColor="#444444" />
                </zimba:Card.CardContent>
                <zimba:Card.Footer>
                    <HorizontalStackLayout HorizontalOptions="End"
                                           Spacing="12">
                        <Button Text="Cancel"
                                BackgroundColor="#E0E0E0"
                                TextColor="#333" />
                        <Button Text="Confirm"
                                BackgroundColor="#1976D2"
                                TextColor="White" />
                    </HorizontalStackLayout>
                </zimba:Card.Footer>
            </zimba:Card>
            <!-- Interactive Card -->
            <zimba:Card Title="Feedback Form"
                        CardCornerRadius="12"
                        HasShadow="True"
                        BackgroundColor="White"
                        ShadowRadius="12"
                        ShadowOpacity="0.3"
                        ShadowOffset="0,6"
                        ShowFooterSection="True"
                        StrokeThickness="0">
                <zimba:Card.CardContent>
                    <VerticalStackLayout Spacing="12">
                        <Entry Placeholder="Your name" />
                        <Editor Background="AliceBlue"
                                Placeholder="Write your feedback here..."
                                HeightRequest="120" />
                    </VerticalStackLayout>
                </zimba:Card.CardContent>
                <zimba:Card.Footer>
                    <Button Text="Submit"
                            BackgroundColor="#43A047"
                            TextColor="White"
                            HorizontalOptions="End" />
                </zimba:Card.Footer>
            </zimba:Card>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>