<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TestApp.MainPage"
             xmlns:zimba="clr-namespace:Zimba.Maui.Controls;assembly=Zimba.Maui.Controls"
             Title="Zimba Controls Test">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Zimba MAUI Controls Test App" 
               FontSize="24" 
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,0,0,20"/>
        
        <Button Text="Test Floating Action Button" 
                Clicked="OnFabTestClicked"
                HorizontalOptions="Center" />
                
        <Button Text="Test Card Control" 
                Clicked="OnCardTestClicked"
                HorizontalOptions="Center" />
                
        <!-- Add more test buttons as you add controls -->
    </VerticalStackLayout>
</ContentPage>